# Database (Supabase)
# Transaction Pooler (Port 6543) — für die App
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORT]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection (Port 5432) — für prisma db push / migrate
DIRECT_URL="postgresql://postgres:[PASSWORT]@db.xxxx.supabase.co:5432/postgres"

# NextAuth
AUTH_SECRET="your-nextauth-secret-min-32-chars-here"
AUTH_URL="http://localhost:3000"

# Token Encryption (32-byte hex = 64 hex chars)
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here-must-be-64-hex-chars"

# Google OAuth (for Gmail provider connection - NOT for app login)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Required scopes: https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.modify
# Redirect URI: http://localhost:3000/api/oauth/gmail/callback

# Microsoft OAuth (for Outlook provider connection - NOT for app login)
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_TENANT_ID="common"
# Required scopes: Mail.Read Mail.ReadWrite offline_access
# Redirect URI: http://localhost:3000/api/oauth/outlook/callback

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mail Control Center"
